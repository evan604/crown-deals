# CrownDeals Environment Configuration
# Copy to .env.local and fill in real values

# Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI (Claude API)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Scraper
APIFY_API_TOKEN=your-apify-token
APIFY_WEBHOOK_SECRET=your-webhook-secret-random-string

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=alerts@crowndeals.com

# SMS (Twilio) - Optional for MVP
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1NUMBER

# Payments (Stripe)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl
NEXTAUTH_URL=http://localhost:3000

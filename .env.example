# CrownDeals Environment Variables
# Copy to .env.local and fill in actual values
# NEVER commit .env.local to git

# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Apify (Required for scraping)
APIFY_API_TOKEN=apify_api_...

# Anthropic Claude (Required for deal scoring)
ANTHROPIC_API_KEY=sk-ant-...

# Resend (Required for email alerts)
RESEND_API_KEY=re_...

# Twilio (Optional - for SMS alerts on Premium tier)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Stripe (Required for payments)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=random-string-for-securing-cron-endpoints
